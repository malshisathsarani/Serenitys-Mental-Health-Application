# =============================================================================
# Environment Configuration
# Copy this file to .env and update with your values
# NEVER commit .env to version control
# =============================================================================

# Application Settings
ENV=development
DEBUG=True
APP_NAME=Mental Health Risk API
APP_VERSION=1.0.0

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Paths (relative to backend directory)
MODEL_DIR=models
DATA_DIR=data
LOGS_DIR=logs

# Model Configuration
MODEL_FILE=text_classifier.joblib
LABELS_FILE=labels.json

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Database Configuration
# MySQL (Production)
DATABASE_URL=mysql+aiomysql://root:@localhost:3306/serenity_db?charset=utf8mb4
# With custom user:
# DATABASE_URL=mysql+aiomysql://serenity_user:serenity_password@localhost:3306/serenity_db?charset=utf8mb4

# SQLite (Development/Demo - easier setup)
# DATABASE_URL=sqlite+aiosqlite:///./serenity.db

# Security (generate secure values for production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-change-in-production

# CORS (update for production)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# =============================================================================
# Twilio Configuration - Emergency Calling System
# =============================================================================
# Set to True to enable automatic emergency calling when crisis detected
TWILIO_ENABLED=False

# Get these values from https://console.twilio.com
# Account SID
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Auth Token
TWILIO_AUTH_TOKEN=your-auth-token-here

# Twilio phone number in E.164 format (country code + number)
# Example for US: +12025551234
TWILIO_PHONE_NUMBER=+12025551234

# Risk score threshold (0.0-1.0) to trigger automatic emergency calls
# Example: 0.75 means calls triggered when risk >= 75%
EMERGENCY_CALL_THRESHOLD=0.75

# Timeout for emergency calls in seconds
EMERGENCY_CALL_TIMEOUT=30

# Maximum number of retries for failed emergency calls
EMERGENCY_CALL_MAX_RETRIES=2


# Health Check
HEALTH_CHECK_ENABLED=True
